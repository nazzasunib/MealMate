# ---------------------------------------------------------------------------
# MealMate environment variables. Copy to `.env` and fill in real values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Supabase Postgres (Project Settings -> Database -> Connection string).
# Pooled connection (Supavisor, port 6543) used by the running app:
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / session connection (port 5432) used by `prisma migrate`:
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings -> API). The anon key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Public site URL, used for auth email redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Time zone that defines "today" (meal days, month boundaries).
# The legacy app used the browser clock; servers run in UTC, so this is explicit.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Dhaka"
